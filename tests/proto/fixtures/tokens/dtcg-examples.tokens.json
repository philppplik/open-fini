{
  "$description": "Examples of every DTCG 2025.10 token type and reference form, written for the OpenFini tests.",
  "base": {
    "$type": "color",
    "blue": {
      "100": { "$value": { "colorSpace": "srgb", "components": [0.86, 0.92, 1], "hex": "#dbeafe" } },
      "500": { "$value": { "colorSpace": "srgb", "components": [0.231, 0.51, 0.965], "hex": "#3b82f6" }, "$description": "Primary blue" },
      "900": { "$value": "#1e3a8a" }
    },
    "green": { "$value": { "colorSpace": "hsl", "components": [142, 71, 45] } },
    "linear-gray": { "$value": { "colorSpace": "srgb-linear", "components": [0.2, 0.2, 0.2] } },
    "glass": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.5 } },
    "oklch-only": { "$value": { "colorSpace": "oklch", "components": [0.7, 0.1, 200] } },
    "oklch-hex": { "$value": { "colorSpace": "oklch", "components": [0.5, 0.2, 30], "hex": "#b3261e" } }
  },
  "brand": {
    "$root": { "$type": "color", "$value": "{base.blue.500}" },
    "strong": { "$type": "color", "$value": "{base.blue.900}" },
    "soft": { "$value": { "$ref": "#/base/blue/100" } }
  },
  "space": {
    "$type": "dimension",
    "sm": { "$value": { "value": 8, "unit": "px" } },
    "md": { "$value": { "value": 1, "unit": "rem" } },
    "lg": { "$value": "24px" },
    "gutter": { "$value": "{space.md}" }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": { "value": 100, "unit": "ms" } },
    "slow": { "$type": "duration", "$value": { "value": 0.5, "unit": "s" } },
    "ease": { "$type": "cubicBezier", "$value": [0.5, 0, 1, 1] }
  },
  "opacity": { "disabled": { "$type": "number", "$value": 0.4 } },
  "font": {
    "family": { "$type": "fontFamily", "$value": ["Inter", "Helvetica", "sans-serif"] },
    "mono": { "$type": "fontFamily", "$value": "JetBrains Mono" },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "bold": { "$value": "bold" },
      "semi": { "$value": "semi-bold" }
    }
  },
  "type": {
    "body": {
      "$type": "typography",
      "$value": { "fontFamily": "{font.mono}", "fontSize": { "value": 16, "unit": "px" }, "fontWeight": "{font.weight.regular}", "letterSpacing": { "value": 0, "unit": "px" }, "lineHeight": 1.5 }
    },
    "heading": {
      "$type": "typography",
      "$value": { "fontFamily": ["Georgia", "serif"], "fontSize": { "value": 2, "unit": "rem" }, "fontWeight": 700, "letterSpacing": { "value": -0.5, "unit": "px" }, "lineHeight": 1.2 }
    }
  },
  "shadow": {
    "card": {
      "$type": "shadow",
      "$value": { "color": "{base.glass}", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 4, "unit": "px" }, "blur": { "value": 12, "unit": "px" }, "spread": { "value": -2, "unit": "px" } }
    },
    "layered": {
      "$type": "shadow",
      "$value": [
        { "color": "#0000001a", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 1, "unit": "px" }, "blur": { "value": 2, "unit": "px" }, "spread": { "value": 0, "unit": "px" } },
        { "color": "#00000033", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 8, "unit": "px" }, "blur": { "value": 24, "unit": "px" }, "spread": { "value": 0, "unit": "px" }, "inset": true }
      ]
    }
  },
  "gradient": {
    "sunrise": {
      "$type": "gradient",
      "$value": [{ "color": "#f97316", "position": 0 }, { "color": "{brand}", "position": 1 }]
    }
  },
  "border": { "thin": { "$type": "border", "$value": { "color": "#000000", "width": { "value": 1, "unit": "px" }, "style": "solid" } } },
  "theme": {
    "$extends": "{space}",
    "lg": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } }
  },
  "broken": { "$type": "color", "$value": "{nowhere.at.all}" }
}
