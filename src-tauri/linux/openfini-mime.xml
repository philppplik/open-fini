<?xml version="1.0" encoding="UTF-8"?>
<!--
  Registers the .ofini document type with shared-mime-info so Linux file managers
  associate it with OpenFini (the .desktop file generated by Tauri lists the MIME type).
-->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-openfini">
    <comment>OpenFini document</comment>
    <glob pattern="*.ofini"/>
  </mime-type>
</mime-info>
