<?xml version="1.0" encoding="UTF-8"?>
<!--
  Registers the OpenFini file types with shared-mime-info so Linux file managers know them, show the
  OpenFini document icon, and offer OpenFini under "Open With" (the .desktop file lists the same MIME types).

  Only types that shared-mime-info does not already ship are declared here (plus the glob of
  .ofini / .ofext). The icon of .ofini is looked up as "application-x-openfini" in the hicolor theme,
  which the packages install from src-tauri/linux/application-x-openfini.*.
-->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-openfini">
    <comment>OpenFini document</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.ofini"/>
    <icon name="application-x-openfini"/>
  </mime-type>
  <mime-type type="application/x-openfini-extension">
    <comment>OpenFini extension</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.ofext"/>
    <icon name="application-x-openfini"/>
  </mime-type>
  <mime-type type="image/vnd.adobe.photoshop-large">
    <comment>Photoshop large document</comment>
    <sub-class-of type="image/vnd.adobe.photoshop"/>
    <glob pattern="*.psb"/>
  </mime-type>
  <mime-type type="application/vnd.adobe.indesign-idml-package">
    <comment>InDesign Markup</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.idml"/>
  </mime-type>
  <mime-type type="application/x-affinity-designer">
    <comment>Affinity Designer document</comment>
    <glob pattern="*.afdesign"/>
  </mime-type>
  <mime-type type="application/x-affinity-photo">
    <comment>Affinity Photo document</comment>
    <glob pattern="*.afphoto"/>
  </mime-type>
  <mime-type type="application/x-affinity-publisher">
    <comment>Affinity Publisher document</comment>
    <glob pattern="*.afpub"/>
  </mime-type>
</mime-info>
