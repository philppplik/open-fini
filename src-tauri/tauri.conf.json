{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OpenFini",
  "version": "../package.json",
  "identifier": "io.github.philppplik.openfini",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:4173",
    "beforeDevCommand": "npm start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OpenFini",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#1c1d21",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval' data: https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com",
        "style-src": "'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com https://fonts.googleapis.com",
        "style-src-attr": "'unsafe-inline'",
        "img-src": "'self' data: blob: https:",
        "media-src": "'self' data: blob: https:",
        "font-src": "'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com",
        "connect-src": "'self' ipc: http://ipc.localhost blob: data: https: http://localhost:* http://127.0.0.1:* ws: wss:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-src": "https:",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/128x128.png",
      "icons/32x32.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "OpenFini contributors",
    "homepage": "https://github.com/philppplik/open-fini",
    "copyright": "Copyright (c) 2026 OpenFini contributors",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "category": "GraphicsAndDesign",
    "shortDescription": "Lightweight vector, pixel and layout studio",
    "longDescription": "OpenFini is a lightweight, open-source creative suite with a Vector studio for illustration, a Pixel studio for photo editing, a Layout studio for page design and a Code studio for building websites, with one-click export to PNG, JPEG, WebP, SVG, PDF and static sites. It runs offline and starts fast.",
    "fileAssociations": [
      {
        "ext": [
          "ofini"
        ],
        "name": "OpenFini Document",
        "description": "OpenFini Document",
        "mimeType": "application/x-openfini",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "io.github.philppplik.openfini.document",
          "conformsTo": [
            "public.data"
          ]
        }
      },
      {
        "ext": [
          "ofext"
        ],
        "name": "OpenFini Extension",
        "description": "OpenFini Extension",
        "mimeType": "application/x-openfini-extension",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "io.github.philppplik.openfini.extension",
          "conformsTo": [
            "public.data"
          ]
        }
      },
      {
        "ext": [
          "vsix"
        ],
        "name": "VS Code Extension",
        "description": "VS Code Extension",
        "mimeType": "application/vsix",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "psd"
        ],
        "name": "Photoshop Document",
        "description": "Photoshop Document",
        "mimeType": "image/vnd.adobe.photoshop",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "psb"
        ],
        "name": "Photoshop Large Document",
        "description": "Photoshop Large Document",
        "mimeType": "image/vnd.adobe.photoshop-large",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "idml"
        ],
        "name": "InDesign Markup",
        "description": "InDesign Markup",
        "mimeType": "application/vnd.adobe.indesign-idml-package",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "svg"
        ],
        "name": "SVG Image",
        "description": "SVG Image",
        "mimeType": "image/svg+xml",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "png"
        ],
        "name": "PNG Image",
