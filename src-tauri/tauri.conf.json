        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "css"
        ],
        "name": "CSS Stylesheet",
        "description": "CSS Stylesheet",
        "mimeType": "text/css",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "js",
          "mjs"
        ],
        "name": "JavaScript File",
        "description": "JavaScript File",
        "mimeType": "text/javascript",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "json"
        ],
        "name": "JSON File",
        "description": "JSON File",
        "mimeType": "application/json",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "txt"
        ],
        "name": "Text File",
        "description": "Text File",
        "mimeType": "text/plain",
        "role": "Viewer",
