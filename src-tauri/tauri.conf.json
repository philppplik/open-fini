        "rank": "Alternate"
      },
      {
        "ext": [
          "aco"
        ],
        "name": "Photoshop Swatches",
        "description": "Photoshop Swatches",
        "mimeType": "application/vnd.adobe.aco",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
