      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "German"
        ],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "installerHooks": "windows/open-with.nsh",
        "template": "windows/installer.nsi",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp",
        "uninstallerHeaderImage": "installer/header.bmp"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "installer/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "linux": {
      "deb": {
        "section": "graphics",
        "priority": "optional",
        "files": {
          "/usr/share/mime/packages/io.github.philppplik.openfini.xml": "linux/openfini-mime.xml",
          "/usr/share/icons/hicolor/scalable/mimetypes/application-x-openfini.svg": "linux/application-x-openfini.svg",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-x-openfini.png": "linux/application-x-openfini.png"
        },
        "desktopTemplate": "linux/openfini.desktop"
      },
      "rpm": {
        "files": {
          "/usr/share/mime/packages/io.github.philppplik.openfini.xml": "linux/openfini-mime.xml",
          "/usr/share/icons/hicolor/scalable/mimetypes/application-x-openfini.svg": "linux/application-x-openfini.svg",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-x-openfini.png": "linux/application-x-openfini.png"
        },
        "desktopTemplate": "linux/openfini.desktop"
      },
      "appimage": {
        "files": {
          "/usr/share/mime/packages/io.github.philppplik.openfini.xml": "linux/openfini-mime.xml",
          "/usr/share/icons/hicolor/scalable/mimetypes/application-x-openfini.svg": "linux/application-x-openfini.svg",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-x-openfini.png": "linux/application-x-openfini.png"
        }
      }
    }
  }
}
