        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "gif"
        ],
        "name": "GIF Image",
        "description": "GIF Image",
        "mimeType": "image/gif",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "bmp"
        ],
        "name": "BMP Image",
        "description": "BMP Image",
        "mimeType": "image/bmp",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "avif"
        ],
        "name": "AVIF Image",
        "description": "AVIF Image",
        "mimeType": "image/avif",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "tif",
