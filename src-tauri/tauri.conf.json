        "description": "Windows Icon",
        "mimeType": "image/vnd.microsoft.icon",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "ora"
        ],
        "name": "OpenRaster Image",
        "description": "OpenRaster Image",
        "mimeType": "image/openraster",
