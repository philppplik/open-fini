{
  "name": "openfini",
  "version": "0.7.0",
  "description": "OpenFini — a lightweight, open-source creative suite with Vector, Pixel, Layout and Export studios. Runs as a PWA and as a tiny native app on Windows (x64/ARM64), macOS (Intel/Apple Silicon) and Linux (x64/ARM64).",
  "type": "module",
  "license": "MIT",
  "private": false,
  "homepage": "https://github.com/philppplik/open-fini#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/philppplik/open-fini.git"
  },
  "bugs": {
    "url": "https://github.com/philppplik/open-fini/issues"
  },
  "keywords": [
    "vector-editor",
    "photo-editor",
    "page-layout",
    "desktop-publishing",
    "design-tool",
    "canvas",
    "pwa",
    "tauri",
    "open-source"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node scripts/test.mjs",
    "build": "node scripts/build.mjs",
    "vendor": "node scripts/vendor.mjs",
    "check:size": "node scripts/check-size.mjs",
    "i18n:extract": "node scripts/i18n-extract.mjs",
    "i18n:check": "node scripts/i18n-extract.mjs --check",
    "icons": "node scripts/icons.mjs",
    "installer:assets": "node scripts/installer-assets.mjs",
    "ext:create": "node sdk/create-extension.mjs",
    "ext:pack": "node sdk/pack.mjs",
    "ext:pack-all": "node scripts/pack-extensions.mjs",
    "mcp:gateway": "node scripts/mcp-gateway.mjs",
    "publish:helper": "node scripts/publish-helper.mjs",
    "relay": "node scripts/relay.mjs",
    "wiki:shortcuts": "node scripts/wiki-shortcuts.mjs",
    "wiki:check": "node scripts/wiki-sync.mjs --check",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
