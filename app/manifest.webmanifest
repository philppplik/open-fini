{
  "name": "OpenFini",
  "short_name": "OpenFini",
  "description": "A lightweight, open-source creative suite with Vector, Pixel, Layout and Code studios. Works offline.",
  "lang": "en-US",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#1c1d21",
  "theme_color": "#1c1d21",
  "categories": ["graphics", "design", "productivity", "photo"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "file_handlers": [
    {
      "action": "./",
      "launch_type": "single-client",
      "accept": {
        "application/x-openfini": [".ofini"],
        "image/svg+xml": [".svg"],
        "image/png": [".png"],
        "image/jpeg": [".jpg", ".jpeg"],
        "image/webp": [".webp"]
      }
    }
  ],
  "shortcuts": [
    {
      "name": "New Vector document",
      "short_name": "Vector",
      "description": "Start a new vector illustration",
      "url": "./?studio=vector",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "New Pixel image",
      "short_name": "Pixel",
      "description": "Start a new raster image or edit a photo",
      "url": "./?studio=pixel",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "New Layout document",
      "short_name": "Layout",
      "description": "Start a new multi-page layout",
      "url": "./?studio=layout",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "New website",
      "short_name": "Website",
      "description": "Build a website with the code editor and visual designer",
      "url": "./?studio=code",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
